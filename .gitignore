# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.wrangler/
.vercel/
.netlify/

# Cloudflare
.dev.vars
.wrangler.toml.bak

# Secrets — never commit
.env
.env.*
# `.env.native` holds only `VITE_API_BASE`, a public Worker URL — see its own header.
# It is NOT a secret, and `src/lib/native/bundle.test.ts` hard-fails without it, so the
# blanket `.env.*` rule above was turning every CI run red on a file that is meant to be
# in the repo. The rule stays for the files that ARE secret (`.dev.vars`, `.env.local`).
!.env.native
!.env.example
*.pem
*.key

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

