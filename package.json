{
  "name": "tessera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.test.json --noEmit && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "bun run build && wrangler d1 migrations apply tessera-db --remote && wrangler deploy",
    "types": "wrangler types",
    "test": "bun test",
    "eval": "bun run scripts/eval/run.ts",
    "db:create": "wrangler d1 create tessera-db",
    "db:migrate:local": "wrangler d1 migrations apply tessera-db --local",
    "db:migrate": "wrangler d1 migrations apply tessera-db --remote",
    "cap:sync": "bun run build:native && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "bun run build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon ./app-icon.svg"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/core": "^8",
    "fflate": "^0.8.3",
    "js-tiktoken": "^1.0.21",
    "marked": "^18.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.143.0"
  }
}
